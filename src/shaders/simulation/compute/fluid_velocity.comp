#version 430

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_velocity;
uniform sampler2D u_mesh_sources;
uniform sampler2D u_jet_mask;
uniform sampler2D u_obstacles;
uniform ivec2 u_size;
uniform float u_time_step;
uniform float u_viscosity;
layout(rg32f, binding = 0) writeonly uniform image2D u_output_velocity;

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(cell, u_size))) {
        return;
    }

    if (texelFetch(u_obstacles, cell, 0).r > 0.5) {
        imageStore(u_output_velocity, cell, vec4(0.0));
        return;
    }

    vec2 velocity = texelFetch(u_velocity, cell, 0).rg;
    vec2 uv = (vec2(cell) + 0.5) / vec2(u_size) - velocity * u_time_step;
    uv = clamp(uv, vec2(0.5) / vec2(u_size), 1.0 - vec2(0.5) / vec2(u_size));
    vec2 advected = texture(u_velocity, uv).rg;
    ivec2 left_cell = max(cell + ivec2(-1, 0), ivec2(0));
    ivec2 right_cell = min(cell + ivec2(1, 0), u_size - 1);
    ivec2 down_cell = max(cell + ivec2(0, -1), ivec2(0));
    ivec2 up_cell = min(cell + ivec2(0, 1), u_size - 1);
    vec2 laplacian = texelFetch(u_velocity, left_cell, 0).rg
        + texelFetch(u_velocity, right_cell, 0).rg
        + texelFetch(u_velocity, down_cell, 0).rg
        + texelFetch(u_velocity, up_cell, 0).rg
        - 4.0 * advected;
    advected += u_viscosity * u_time_step * laplacian;
    vec4 source = texelFetch(u_mesh_sources, cell, 0);
    float jet = texelFetch(u_jet_mask, cell, 0).r;

    if (jet > 0.0) {
        advected = mix(advected, source.ba, clamp(jet, 0.0, 1.0));
    } else {
        advected += source.rg * u_time_step;
    }

    if (
        cell.x == 0 || cell.y == 0
        || cell.x == u_size.x - 1 || cell.y == u_size.y - 1
    ) {
        advected = vec2(0.0);
    }
    imageStore(u_output_velocity, cell, vec4(advected, 0.0, 0.0));
}
