#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D u_current;
layout(r8ui, binding = 1) writeonly uniform uimage2D u_next;

uniform ivec2 u_grid_size;
uniform float u_temperature;
uniform float u_coupling;
uniform float u_external_field;
uniform int u_parity;
uniform uint u_step;

float random01(ivec2 p, uint step) {
    uint n = uint(p.x) * 1973u
           + uint(p.y) * 9277u
           + step * 26699u
           + uint(u_parity) * 31847u;

    n = (n ^ (n >> 13u)) * 1274126177u;
    n ^= n >> 16u;

    return float(n) / 4294967296.0;
}

int spin_at(ivec2 p) {
    p = (p + u_grid_size) % u_grid_size;

    return texelFetch(u_current, p, 0).r == 0u
        ? -1
        : 1;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(p, u_grid_size))) {
        return;
    }

    uint current_state = texelFetch(u_current, p, 0).r;

    if (((p.x + p.y) & 1) != u_parity) {
        imageStore(u_next, p, uvec4(current_state, 0u, 0u, 1u));
        return;
    }

    int spin = current_state == 0u ? -1 : 1;

    int neighbour_sum =
          spin_at(p + ivec2(-1,  0))
        + spin_at(p + ivec2( 1,  0))
        + spin_at(p + ivec2( 0, -1))
        + spin_at(p + ivec2( 0,  1));

    float delta_energy = 2.0 * float(spin) * (
        u_coupling * float(neighbour_sum)
        + u_external_field
    );

    bool accept = delta_energy <= 0.0;

    if (!accept && u_temperature > 0.0) {
        accept = random01(p, u_step)
            < exp(-delta_energy / u_temperature);
    }

    uint next_state = current_state;

    if (accept) {
        next_state = current_state == 0u ? 1u : 0u;
    }

    imageStore(u_next, p, uvec4(next_state, 0u, 0u, 1u));
}