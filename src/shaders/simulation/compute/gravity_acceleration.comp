#version 430

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec4 positions[];
};
layout(std430, binding = 1) readonly buffer Masses {
    vec4 masses[];
};
layout(std430, binding = 2) writeonly buffer Accelerations {
    vec4 accelerations[];
};

uniform int u_count;
uniform float u_gravitational_constant;
uniform float u_softening;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(u_count)) {
        return;
    }

    vec3 position = positions[index].xyz;
    vec3 acceleration = vec3(0.0);
    float softening_squared = u_softening * u_softening;
    for (int other = 0; other < u_count; ++other) {
        if (other == int(index)) {
            continue;
        }

        vec3 displacement = positions[other].xyz - position;
        float distance_squared = dot(displacement, displacement)
            + softening_squared;
        float inverse_distance_cubed = inversesqrt(distance_squared)
            / distance_squared;
        acceleration += u_gravitational_constant
            * masses[other].x
            * displacement
            * inverse_distance_cubed;
    }

    accelerations[index] = vec4(acceleration, 0.0);
}
