#version 430

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer Positions {
    vec4 positions[];
};
layout(std430, binding = 1) buffer Velocities {
    vec4 velocities[];
};
layout(std430, binding = 2) readonly buffer PreviousAccelerations {
    vec4 previous_accelerations[];
};
layout(std430, binding = 3) readonly buffer NextAccelerations {
    vec4 next_accelerations[];
};

uniform int u_count;
uniform int u_stage;
uniform float u_time_step;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(u_count)) {
        return;
    }

    if (u_stage == 0) {
        positions[index].xyz += velocities[index].xyz * u_time_step
            + 0.5 * previous_accelerations[index].xyz
                * u_time_step * u_time_step;
    } else {
        velocities[index].xyz += 0.5
            * (previous_accelerations[index].xyz
                + next_accelerations[index].xyz)
            * u_time_step;
    }
}
