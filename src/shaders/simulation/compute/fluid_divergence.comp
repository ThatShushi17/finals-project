#version 430

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_velocity;
uniform sampler2D u_obstacles;
uniform ivec2 u_size;
layout(r32f, binding = 0) writeonly uniform image2D u_divergence;

vec2 velocity_at(ivec2 cell, ivec2 center) {
    if (
        any(lessThan(cell, ivec2(0)))
        || any(greaterThanEqual(cell, u_size))
        || texelFetch(u_obstacles, cell, 0).r > 0.5
    ) {
        return vec2(0.0);
    }
    return texelFetch(u_velocity, cell, 0).rg;
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(cell, u_size))) {
        return;
    }
    if (texelFetch(u_obstacles, cell, 0).r > 0.5) {
        imageStore(u_divergence, cell, vec4(0.0));
        return;
    }

    vec2 left = velocity_at(cell + ivec2(-1, 0), cell);
    vec2 right = velocity_at(cell + ivec2(1, 0), cell);
    vec2 down = velocity_at(cell + ivec2(0, -1), cell);
    vec2 up = velocity_at(cell + ivec2(0, 1), cell);
    float divergence = 0.5 * (
        right.x - left.x + up.y - down.y
    );
    imageStore(u_divergence, cell, vec4(divergence));
}
