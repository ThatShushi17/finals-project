#version 430

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_dye;
uniform sampler2D u_velocity;
uniform sampler2D u_dye_source;
uniform sampler2D u_obstacles;
uniform ivec2 u_size;
uniform float u_time_step;
layout(r32f, binding = 0) writeonly uniform image2D u_output_dye;

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(cell, u_size))) {
        return;
    }
    if (texelFetch(u_obstacles, cell, 0).r > 0.5) {
        imageStore(u_output_dye, cell, vec4(0.0));
        return;
    }

    vec2 velocity = texelFetch(u_velocity, cell, 0).rg;
    vec2 uv = (vec2(cell) + 0.5) / vec2(u_size) - velocity * u_time_step;
    uv = clamp(uv, vec2(0.5) / vec2(u_size), 1.0 - vec2(0.5) / vec2(u_size));
    float dye = texture(u_dye, uv).r * 0.996;
    dye += texelFetch(u_dye_source, cell, 0).r * u_time_step * 2.5;
    imageStore(u_output_dye, cell, vec4(clamp(dye, 0.0, 1.0)));
}
