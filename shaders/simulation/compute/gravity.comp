#version 430 core
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PositionBuffer {{ 
    vec4 positions[]; 
}};

layout(std430, binding = 1) buffer VelocityBuffer {{ 
    vec4 velocities[]; 
}};

// Binding 2: Output vector containing (Kinetic, Potential) energy per particle
layout(std430, binding = 2) buffer EnergyBuffer {{ 
    vec2 energies[]; 
}};

uniform int u_num_particles;
uniform float u_G;

void main() {{
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_num_particles) return;

    vec3 pos_i = positions[i].xyz;
    vec3 vel_i = velocities[i].xyz;
    float mass_i = positions[i].w;

    vec3 total_acceleration = vec3(0.0);
    float potential_energy_i = 0.0;

    for (int j = 0; j < u_num_particles; j++) {{
        if (i == uint(j)) continue;

        float dx = positions[j].x - pos_i.x;
        float dy = positions[j].y - pos_i.y;
        float dz = positions[j].z - pos_i.z;
        float mass_j = positions[j].w;
        
        float r_sq = dx*dx + dy*dy + dz*dz + 0.02; 
        float r = sqrt(r_sq);

        float ax = {ax_expr};
        float ay = {ay_expr};
        float az = {az_expr};

        total_acceleration += vec3(ax, ay, az);

        // Accumulate pairwise potential energy (-0.5 factor handles double-counting across threads)
        potential_energy_i += -0.5 * u_G * mass_i * mass_j / r;
    }}

    vel_i += total_acceleration;

    vec3 next_pos = pos_i + vel_i;
    if (abs(next_pos.x) > 2.0) vel_i.x *= -0.9;
    if (abs(next_pos.y) > 2.0) vel_i.y *= -0.9;
    if (abs(next_pos.z) > 2.0) vel_i.z *= -0.9;

    positions[i].xyz = pos_i + vel_i;
    velocities[i].xyz = vel_i;

    // Kinetic Energy = 0.5 * m * v^2
    float kinetic_energy_i = 0.5 * mass_i * dot(vel_i, vel_i);

    // Write state variables directly in the same pass
    energies[i] = vec2(kinetic_energy_i, potential_energy_i);
}}